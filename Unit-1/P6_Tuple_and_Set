# Tuple
t = (10, 20, 30, 20, 40)

print("Tuple:", t)
print("First element:", t[0])
print("Count of 20:", t.count(20))
print("Index of 30:", t.index(30))

# Set
s = {10, 20, 30, 40}

print("Set:", s)

s.add(50)
print("After add:", s)

s.remove(20)
print("After remove:", s)

print("Length:", len(s))